[Unit]
Description=Apply Mocca backup retention and check Backblaze B2 repository
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/mocca-backup.env
WorkingDirectory=/home/sebastian/mocca
ExecStart=/usr/bin/bash /home/sebastian/mocca/ops/prune-production.sh
TimeoutStartSec=0
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7