{
	"name": "@mocca/db",
	"version": "0.0.0",
	"private": true,
	"description": "Database module for the Mocca app",
	"files": [
		"src",
		"dist"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"db:generate": "drizzle-kit generate --config drizzle.config.ts",
		"db:grant-default-privileges": "tsx src/grant-default-privileges.ts",
		"db:migrate": "pnpm run db:grant-default-privileges && drizzle-kit migrate --config drizzle.config.ts"
	},
	"keywords": [],
	"author": "Sebastian A. Martinez",
	"license": "ISC",
	"type": "module",
	"dependencies": {
		"drizzle-orm": "1.0.0-rc.4",
		"pg": "^8.23.0"
	},
	"devDependencies": {
		"@types/pg": "^8.23.1",
		"dotenv": "^18.0.4",
		"drizzle-kit": "1.0.0-rc.4",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
